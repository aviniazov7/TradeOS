rules_version = '2';

// Chart screenshots. Bytes live here; the Firestore doc
// users/{uid}/tradeImages/{tradeId_slot} only points at the path.
// Anything outside a user's own charts/ folder is denied (no match).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/charts/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // create/update see request.resource. delete does not, so it is separate
      // — a size check on `write` would reject every delete.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
