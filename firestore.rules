rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is a signed-in user whose own root document has role == 'admin'.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Privileged fields a user must NOT be able to set/change on themselves.
    // (Granted only server-side via the Admin SDK / Firebase Console, which
    // bypass these rules.) Without this, anyone could write plan:"premium" or
    // role:"admin" to their own doc and self-escalate.
    function noPrivilegeEscalation() {
      return request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
        && request.resource.data.get('planExpires', '') == resource.data.get('planExpires', '')
        // Server-authoritative monetization fields — set only by the Admin SDK
        // (adminGrantPremium / payment flow), never by the user. Pinning them
        // stops a user fabricating revenue ($100k "payments") that would poison
        // the admin MRR/churn analytics.
        && request.resource.data.get('planAmount', 0) == resource.data.get('planAmount', 0)
        && request.resource.data.get('planDays', 0) == resource.data.get('planDays', 0)
        && request.resource.data.get('planGrantedAt', '') == resource.data.get('planGrantedAt', '')
        // Registration date — set once at signup, immutable afterwards.
        // Letting a user rewrite their own createdAt would inflate the
        // "new signups this week" metric in the admin weekly digest (worker
        // buildAdminDigest counts users by createdAt). Safe for every client
        // write path: all profile updates are merge writes that omit
        // createdAt (touchLastActive, settings, onboardingCompleted,
        // isPublicProfile, leaderboardName), and in rules the merged value of
        // an omitted field equals the stored one, so this equality holds.
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    match /users/{userId} {
      // Owners read their own doc; admins may read any user doc
      // (read-only — admins cannot write to other users' data).
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // On create, role/plan may only be the safe defaults.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('plan', 'free') == 'free'
        // Monetization fields are server-authoritative (Admin SDK grant /
        // payment flow). A first-write client never sends them — AuthContext's
        // defaultProfile omits plan/role/planAmount/planDays/planGrantedAt/
        // planExpires — so pinning them to defaults on CREATE (the UPDATE path
        // is already covered by noPrivilegeEscalation) stops a raw-SDK signup
        // from fabricating revenue/expiry that would poison admin MRR/churn.
        && request.resource.data.get('planAmount', 0) == 0
        && request.resource.data.get('planDays', 0) == 0
        && request.resource.data.get('planGrantedAt', '') == ''
        && request.resource.data.get('planExpires', '') == '';
      // On update, either:
      // - the owner is editing their own non-privileged fields, or
      // - an admin is editing any field on any user (including plan/role).
      // Admins are trusted because the isAdmin() check itself reads the
      // caller's own role from Firestore, which they can't write to themselves
      // (the noPrivilegeEscalation rule blocks them).
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId && noPrivilegeEscalation());
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Owners write their own data; admins may read (read-only, for the admin panel).
      match /trades/{tradeId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId
          && isValidTrade(request.resource.data);
        allow update: if request.auth != null && request.auth.uid == userId
          && isValidTradeUpdate(request.resource.data, resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /backtests/{backtestId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /backtestJournals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /dca/{dcaId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /strategies/{strategyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /tradingPlans/{planId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /settings/{settingId} {
        // Owner-only — admins must NOT be able to read this subcollection.
        // It holds exchange API keys/secrets (settings/exchanges) in
        // plaintext; granting isAdmin() read here would expose every user's
        // exchange credentials (potentially trade/withdraw-capable) to any
        // admin account, so a single admin compromise would leak them all.
        // The admin panel reads only the `settings` MAP field on the root
        // users/{uid} doc (baseCurrency / defaultLeverage / …), never this
        // subcollection, so owner-only read does not break the panel.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /journals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /morningJournals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /eveningJournals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /processes/{processId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /signals/{signalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /watchlist/{itemId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        // Owner-only write, plus a server-side size/shape backstop. The client
        // sanitizes tvLink at render (safeUrl) but not on the write path, so
        // without this a user could setDoc arbitrary/oversized fields directly
        // via the SDK — bounding them here caps storage abuse and gives
        // defence-in-depth on the exact fields the UI renders.
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isValidWatchlistItem(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Admin private notes & tags — per-user, only admins can read or write.
    // Kept OUT of the user's own document so it's never visible to the user
    // themselves (they can read their own user doc, but not this).
    match /adminNotes/{userId} {
      allow read, write: if isAdmin();
    }

    // Payment records (revenue tracking) — admin-only.
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Leaderboard — public read, write only own entry with validated fields
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == entryId
        && isValidLeaderboardEntry(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == entryId;
    }

    // Trade field validation — two shapes share the common checks:
    // crypto perps (the default; a missing assetClass means crypto, for
    // back-compat with every pre-existing trade) and CME futures, where
    // leverage is replaced by a contract spec (pointValue × contracts
    // drives dollar P&L — see docs/specs/futures-contracts.md).
    function isValidTradeCommon(data) {
      return data.entryPrice is number && data.entryPrice > 0
        && data.quantity is number && data.quantity > 0
        && data.stopLoss is number && data.stopLoss >= 0
        && data.fees is number && data.fees >= 0
        && data.direction in ['long', 'short']
        && data.status in ['open', 'closed', 'partial']
        && data.pair is string && data.pair.size() > 0 && data.pair.size() <= 30;
    }

    function isValidTrade(data) {
      return isValidTradeCommon(data)
        && (data.get('assetClass', 'crypto') == 'futures_cme'
          ? (data.contract is map
            && data.contract.contracts is number && data.contract.contracts > 0
            && data.contract.pointValue is number && data.contract.pointValue > 0
            && data.contract.tickSize is number && data.contract.tickSize > 0)
          : (data.leverage is number && data.leverage >= 1 && data.leverage <= 200));
    }

    // Trade UPDATE validation. updateDoc() merges, so `data` here is the FULL
    // post-merge document — but re-running isValidTrade() on it outright would
    // brick legacy documents: trades written before create-validation existed
    // (and before the futures dual-shape) can carry string prices / missing
    // fees, and ANY update to them — even {journalId: x} from the journal
    // migration — would be denied because the merged doc still holds the old
    // field. Instead we validate only the fields this update actually CHANGES:
    // untouched legacy values are grandfathered, while nobody can move a
    // validated field to an invalid value (entryPrice: -1, direction: 'x').
    // Fields the app adds only after create (exits/result/netPnl/updatedAt/
    // tpReached/limitTriggered/…) are not constrained by create either, so
    // they pass untouched.
    function isValidTradeUpdate(data, prev) {
      let changed = data.diff(prev).affectedKeys();
      return (!changed.hasAny(['entryPrice']) || (data.entryPrice is number && data.entryPrice > 0))
        && (!changed.hasAny(['quantity']) || (data.quantity is number && data.quantity > 0))
        // stopLoss accepts a bounded string too: the deployed client's
        // auto-SL path (PendingLimitOrders.handleUpdateSL) writes
        // String(newSL), and old app versions stay in the wild — a
        // number-only rule would silently break their SL updates.
        && (!changed.hasAny(['stopLoss'])
          || (data.stopLoss is number && data.stopLoss >= 0)
          || (data.stopLoss is string && data.stopLoss.size() <= 30))
        && (!changed.hasAny(['fees']) || (data.fees is number && data.fees >= 0))
        && (!changed.hasAny(['direction']) || data.direction in ['long', 'short'])
        && (!changed.hasAny(['status']) || data.status in ['open', 'closed', 'partial'])
        && (!changed.hasAny(['pair']) || (data.pair is string && data.pair.size() > 0 && data.pair.size() <= 30))
        // Same crypto/futures branch as create, applied only when the update
        // touches the fields that pick or feed the branch.
        && (!changed.hasAny(['assetClass', 'leverage', 'contract'])
          || (data.get('assetClass', 'crypto') == 'futures_cme'
            ? (data.contract is map
              && data.contract.contracts is number && data.contract.contracts > 0
              && data.contract.pointValue is number && data.contract.pointValue > 0
              && data.contract.tickSize is number && data.contract.tickSize > 0)
            : (data.leverage is number && data.leverage >= 1 && data.leverage <= 200)));
    }

    // Minimal shape backstop for the free-form subcollections (journals,
    // backtests, dca, strategies, notes, tradingPlans, morningJournals,
    // eveningJournals, processes, signals, backtestJournals). Their documents
    // are written by many forms with varied shapes — the widest legitimate
    // shape today is ~20 fields (PlanForm) — so this deliberately caps only
    // the FIELD COUNT, not per-field content: the goal is blocking raw-SDK
    // megablob documents, not enforcing a strict schema.
    function isBoundedDoc(data) {
      return data.size() < 60;
    }

    // Leaderboard entry validation. Must match the exact shape the client
    // writes (useLeaderboardSync.js): displayName, photoURL, joinedAt,
    // updatedAt, live{}, backtest{}, score. The previous version validated
    // top-level winRate/totalTrades/profitFactor — fields the client never
    // writes — so EVERY legitimate write was permission-denied. Now we also
    // bound `score` (the sort key) to 0–100 so a user can't setDoc score:999999
    // and pin themselves to the top.
    // photoURL must be https (or null/empty) — it's rendered as an <img src>
    // to EVERY signed-in user, and the client only ever sends the Firebase
    // Auth provider photo (always https) or null, so a javascript:/data:
    // value can only come from a raw-SDK write. live/backtest are key-capped
    // (client writes 6 and 3 keys) so this world-readable doc can't become
    // free unbounded storage.
    function isValidLeaderboardEntry(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'joinedAt', 'updatedAt', 'live', 'backtest', 'score'])
        && data.displayName is string && data.displayName.size() <= 50
        && (!('photoURL' in data) || data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 1000
            && (data.photoURL == '' || data.photoURL.matches('https://.*'))))
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.live is map && data.live.size() < 40
        && data.backtest is map && data.backtest.size() < 40;
    }

    // Watchlist item validation. Must match the exact shape the client writes:
    // create (handleAdd) sets coingeckoId/symbol/name/thumb/addedPrice/note/
    // targetPrice/tvLink/createdAt; update (saveEdit) merges note/targetPrice/
    // tvLink/updatedAt onto the existing doc. Every user string that later
    // reaches the DOM (thumb/note/tvLink) is length-capped so a raw-SDK write
    // can't persist an oversized/abusive payload; numbers are type-pinned.
    function isValidWatchlistItem(data) {
      return data.keys().hasOnly(['coingeckoId', 'symbol', 'name', 'thumb', 'addedPrice', 'note', 'targetPrice', 'tvLink', 'createdAt', 'updatedAt', 'bias'])
        // bias: long/short tag that opts the coin into the Wyckoff scanner (null
        // = watched but not scanned). Only the two known values or null.
        && (!('bias' in data) || data.bias == null || data.bias in ['long', 'short'])
        && data.coingeckoId is string && data.coingeckoId.size() > 0 && data.coingeckoId.size() <= 100
        && data.symbol is string && data.symbol.size() > 0 && data.symbol.size() <= 60
        && data.name is string && data.name.size() <= 200
        && (!('thumb' in data) || data.thumb == null || (data.thumb is string && data.thumb.size() <= 1000))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 600))
        && (!('tvLink' in data) || data.tvLink == null || (data.tvLink is string && data.tvLink.size() <= 1000))
        && (!('targetPrice' in data) || data.targetPrice == null || data.targetPrice is number)
        && (!('addedPrice' in data) || data.addedPrice == null || data.addedPrice is number);
    }
  }
}
