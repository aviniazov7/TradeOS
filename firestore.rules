rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is a signed-in user whose own root document has role == 'admin'.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fields a user may write on their OWN root profile doc — an allowlist,
    // so any field not named here is server-authoritative. That covers the
    // real gating fields (role / plan / planExpires), the monetization fields
    // (planAmount / planDays / planGrantedAt — a user faking $100k "payments"
    // would poison the admin MRR/churn analytics), and any privilege-looking
    // name a future feature might read (isPremium / isAdmin / admin /
    // subscription / premiumUntil …). Those are written only by the Admin SDK
    // (Worker, Firebase Console) or an admin, which these rules don't block.
    //
    // Every client write path, for reference: AuthContext first-sign-in
    // profile (displayName, email, photoURL, createdAt, lastActive,
    // appVersion, onboardingCompleted, settings); touchLastActive (lastActive,
    // appVersion); ProfilePage (avatarDataUrl, settings, isPublicProfile,
    // leaderboardName); OnboardingWizard (onboardingCompleted); Journal/
    // Backtest migrations (settings). Add a key here when a new one appears.
    function ownerProfileKeys() {
      return ['displayName', 'email', 'photoURL', 'avatarDataUrl', 'settings',
              'onboardingCompleted', 'lastActive', 'appVersion',
              'isPublicProfile', 'leaderboardName',
              // Marketing-email choice: explicit bool from signup or the profile
              // toggle. A missing field is only for profiles that predate the
              // checkbox; the Worker backfill subscribes those once.
              // Unsubscribing sets it false.
              'marketingEmails', 'marketingEmailsAt'];
    }

    // Keys the client may keep inside users/{uid}.settings. A setDoc merge
    // replaces the whole map, so writers must patch with a dotted path
    // (settings.journalMigrated) — see patchUserSettings. Unknown keys cannot
    // be added. Secret names are rejected anywhere in the map, including keys
    // that were already there, so a parked apiKey blocks further settings
    // writes until the map is replaced without it.
    function profileSettingsKeys() {
      return ['defaultLeverage', 'defaultRiskPercent', 'baseCurrency', 'assetClasses',
              'strategies', 'favoriteCoins', 'journalMigrated', 'backtestMigrated'];
    }

    function secretFieldNames() {
      return ['apiKey', 'apiSecret', 'secret', 'apiPassphrase', 'passphrase', 'privateKey', 'seed'];
    }

    function settingsValuesOk(s) {
      return s is map
        && !s.keys().hasAny(secretFieldNames())
        && (!('defaultLeverage' in s) || (s.defaultLeverage is number && s.defaultLeverage >= 1 && s.defaultLeverage <= 200))
        && (!('defaultRiskPercent' in s) || (s.defaultRiskPercent is number && s.defaultRiskPercent >= 0 && s.defaultRiskPercent <= 100))
        && (!('baseCurrency' in s) || (s.baseCurrency is string && s.baseCurrency.size() > 0 && s.baseCurrency.size() <= 12))
        && (!('assetClasses' in s) || (
             s.assetClasses is list
             && s.assetClasses.size() >= 1
             && s.assetClasses.size() <= 3
             && s.assetClasses.hasOnly(['crypto', 'stocks', 'futures_cme'])
           ))
        && (!('strategies' in s) || (s.strategies is list && s.strategies.size() <= 40))
        && (!('favoriteCoins' in s) || (s.favoriteCoins is list && s.favoriteCoins.size() <= 60))
        && (!('journalMigrated' in s) || s.journalMigrated is bool)
        && (!('backtestMigrated' in s) || s.backtestMigrated is bool);
    }

    function settingsOnCreateOk() {
      return !('settings' in request.resource.data)
        || (
          request.resource.data.settings is map
          && request.resource.data.settings.keys().hasOnly(profileSettingsKeys())
          && settingsValuesOk(request.resource.data.settings)
        );
    }

    // Nested diff: an older extra key that is not a secret does not block a
    // patch of journalMigrated. Adding apiKey, or leaving one in the map, does.
    function settingsOnUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings'])
        || (
          request.resource.data.settings is map
          && settingsValuesOk(request.resource.data.settings)
          && (
            !(resource.data.settings is map)
            || request.resource.data.settings.diff(resource.data.settings).affectedKeys().hasOnly(profileSettingsKeys())
          )
          && (
            resource.data.settings is map
            || request.resource.data.settings.keys().hasOnly(profileSettingsKeys())
          )
        );
    }

    // Profile email is the Auth email. A user cannot point coupon or campaign
    // mail at a third party by editing this field. Absent on both sides is fine.
    function emailMatchesAuth(value) {
      return value == request.auth.token.email;
    }

    function emailOnCreateOk() {
      return !('email' in request.resource.data) || emailMatchesAuth(request.resource.data.email);
    }

    function emailOnUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
        || emailMatchesAuth(request.resource.data.email);
    }

    // marketingEmails must be a bool and marketingEmailsAt a timestamp when
    // present, so the field the campaign filter trusts can't hold junk.
    function marketingFieldsOk(data) {
      return (!('marketingEmails' in data) || data.marketingEmails is bool)
        && (!('marketingEmailsAt' in data) || data.marketingEmailsAt is timestamp);
    }

    // createdAt is set once at signup and is immutable afterwards (the admin
    // weekly digest counts new signups by it), so it's allowed on create only.
    function ownerProfileCreateOk() {
      return request.resource.data.keys().hasOnly(ownerProfileKeys().concat(['createdAt']))
        && marketingFieldsOk(request.resource.data)
        && emailOnCreateOk()
        && settingsOnCreateOk();
    }

    // Only the keys this write actually changes are checked, so fields an older
    // app version left on the doc never block a profile update.
    function ownerProfileUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerProfileKeys())
        && marketingFieldsOk(request.resource.data)
        && emailOnUpdateOk()
        && settingsOnUpdateOk();
    }

    // Secret field names are forbidden anywhere in settings. The encrypted
    // copy lives in Worker KV; Firestore keeps a connection marker only.
    function noSecretFieldNames(data) {
      return data is map
        && !data.keys().hasAny(['apiKey', 'apiSecret', 'secret', 'apiPassphrase', 'passphrase']);
    }

    function exchangeMarkerOk(m) {
      return m is map
        && m.keys().hasOnly(['connected', 'connectedAt', 'connectedAtEstimated', 'address', 'readOnlyVerified'])
        && (!('connected' in m) || m.connected is bool)
        && (!('connectedAt' in m) || m.connectedAt is number)
        && (!('connectedAtEstimated' in m) || m.connectedAtEstimated is bool)
        && (!('address' in m) || (m.address is string && m.address.size() <= 80))
        && (!('readOnlyVerified' in m) || m.readOnlyVerified is bool);
    }

    function exchangesSettingsOk(data) {
      return data is map
        && data.keys().hasOnly(['bybit', 'mexc', 'okx', 'bitget', 'binance', 'hyperliquid'])
        && (!('bybit' in data) || exchangeMarkerOk(data.bybit))
        && (!('mexc' in data) || exchangeMarkerOk(data.mexc))
        && (!('okx' in data) || exchangeMarkerOk(data.okx))
        && (!('bitget' in data) || exchangeMarkerOk(data.bitget))
        && (!('binance' in data) || exchangeMarkerOk(data.binance))
        && (!('hyperliquid' in data) || exchangeMarkerOk(data.hyperliquid));
    }

    // API key lookup. The document id is the SHA-256 of the secret (tos_…).
    // Only the Worker (Admin SDK, which bypasses rules) writes it. Clients
    // cannot read or list the hash index.
    match /apiKeyIndex/{hash} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Owners read their own doc; admins may read any user doc
      // (read-only — admins cannot write to other users' data).
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Owners create / edit only the profile fields in ownerProfileKeys().
      // Admins may edit any field on any user (plan grants, role) — trusted
      // because isAdmin() reads the caller's own role, which no one can write
      // on themselves (it isn't in the owner allowlist).
      allow create: if request.auth != null && request.auth.uid == userId
        && ownerProfileCreateOk();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId && ownerProfileUpdateOk());
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Owners write their own data; admins may read (read-only, for the admin panel).
      match /trades/{tradeId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId
          && isValidTrade(request.resource.data);
        allow update: if request.auth != null && request.auth.uid == userId
          && isValidTradeUpdate(request.resource.data, resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /backtests/{backtestId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /backtestJournals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /dca/{dcaId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /strategies/{strategyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /notes/{noteId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /tradingPlans/{planId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /settings/{settingId} {
        // Owner-only — admins must NOT be able to read this subcollection.
        // Exchange API secrets belong in the encrypted Worker KV store, never
        // in this document. settings/exchanges accepts only a non-secret
        // connection marker. Other settings docs reject the same field names
        // at the top level so a secret cannot be parked next to notifications.
        // The admin panel reads only the `settings` MAP field on the root
        // users/{uid} doc (baseCurrency / defaultLeverage / …), never this
        // subcollection, so owner-only read does not break the panel.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && (
            (settingId == 'exchanges' && exchangesSettingsOk(request.resource.data))
            || (settingId != 'exchanges' && noSecretFieldNames(request.resource.data))
          );
      }
      // Public-API keys. Metadata only (name, prefix, timestamps) — the hash
      // lives in apiKeyIndex, which clients cannot read. The Worker creates
      // keys; the owner can read and delete them (account wipe). Revoke from
      // the app goes through the Worker so the hash index is removed too.
      match /apiKeys/{keyId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }
      // Idempotency records for POST /api/v1/trades. No secret material.
      // Owner read/delete so account deletion can list and wipe them.
      match /apiIdempotency/{idemId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }
      match /journals/{journalId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /morningJournals/{journalId} {
        // Owner-only: the mental journal (emotions, sleep, lessons) is the most
        // personal data in the app — admins deliberately cannot read it.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /eveningJournals/{journalId} {
        // Owner-only: the mental journal (emotions, sleep, lessons) is the most
        // personal data in the app — admins deliberately cannot read it.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /processes/{processId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      // Per-user tracked Polymarket wallets (owner-only, size-bounded).
      match /polymarketWatch/{watchId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      // Per-user Polymarket strategies (saved rule-sets the strategy tab runs).
      match /polymarketStrategies/{strategyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == userId
          && isBoundedDoc(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      // Legacy chart screenshots (data URLs) attached to a trade. Kept out
      // of the trade doc itself — trades are subscribed live everywhere, so
      // image payloads there would slow every screen. Owner-only (no admin
      // read either): a screenshot can show balances/positions, and the admin
      // panel never needs it. New charts are TradingView links on the trade;
      // the client no longer creates these docs.
      // Doc ids are the fixed slots `${tradeId}_0..3`, which caps a trade at
      // 4 screenshots server-side and lets trade deletion clean up without
      // reading. A slot can only be CREATED (a setDoc over a taken slot is an
      // update and fails the unchanged-image check); afterwards only the tag
      // and caption may change.
      match /tradeImages/{imageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && isValidTradeImage(request.resource.data)
          && imageId in [
            request.resource.data.tradeId + '_0',
            request.resource.data.tradeId + '_1',
            request.resource.data.tradeId + '_2',
            request.resource.data.tradeId + '_3'
          ];
        allow update: if request.auth != null && request.auth.uid == userId
          && isValidTradeImage(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'caption', 'updatedAt']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Admin private notes & tags — per-user, only admins can read or write.
    // Kept OUT of the user's own document so it's never visible to the user
    // themselves (they can read their own user doc, but not this).
    match /adminNotes/{userId} {
      allow read, write: if isAdmin();
    }

    // Payment records (revenue tracking) — admin-only.
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Admin notification center. Generated by Cloud Functions (Admin SDK,
    // which bypasses these rules) and read/updated by the admin UI.
    // adminNotifications — the feed (admins mark read from the client).
    // adminNotificationSettings — global + per-type toggles and thresholds.
    // adminNotificationState — per-user dedupe (open episode); admins may
    // inspect it, clients of non-admins cannot.
    match /adminNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }
    match /adminNotificationSettings/{settingId} {
      allow read, write: if isAdmin();
    }
    match /adminNotificationState/{userId} {
      allow read, write: if isAdmin();
    }

    // Admin mailbox (feedback + system notices). The Worker writes documents
    // with the Firebase Admin SDK, which bypasses these rules. The admin UI
    // may only flip read / archive — not rewrite the message.
    match /adminInbox/{messageId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt', 'archived', 'archivedAt'])
        && request.resource.data.read is bool
        && request.resource.data.archived is bool
        && (request.resource.data.readAt == null || request.resource.data.readAt is timestamp)
        && (request.resource.data.archivedAt == null || request.resource.data.archivedAt is timestamp);
      allow create, delete: if false;
    }

    // Leaderboard — public read, write only own entry with validated fields
    match /leaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == entryId
        && isValidLeaderboardEntry(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == entryId;
    }

    // Trade field validation — two shapes share the common checks:
    // crypto perps (the default; a missing assetClass means crypto, for
    // back-compat with every pre-existing trade) and CME futures, where
    // leverage is replaced by a contract spec (pointValue × contracts
    // drives dollar P&L — see docs/specs/futures-contracts.md).
    function isValidTradeCommon(data) {
      return data.entryPrice is number && data.entryPrice > 0
        && data.quantity is number && data.quantity > 0
        && data.stopLoss is number && data.stopLoss >= 0
        && data.fees is number && data.fees >= 0
        && data.direction in ['long', 'short']
        && data.status in ['open', 'closed', 'partial']
        && data.pair is string && data.pair.size() > 0 && data.pair.size() <= 30;
    }

    function isValidTrade(data) {
      return isValidTradeCommon(data)
        && (data.get('assetClass', 'crypto') == 'futures_cme'
          ? (data.contract is map
            && data.contract.contracts is number && data.contract.contracts > 0
            && data.contract.pointValue is number && data.contract.pointValue > 0
            && data.contract.tickSize is number && data.contract.tickSize > 0)
          : (data.leverage is number && data.leverage >= 1 && data.leverage <= 200))
        // setups is optional. Trades written before the field existed omit it.
        && (!('setups' in data) || setupsFieldOk(data.setups))
        // Chart links are optional. Trades written before the field omit it.
        && (!('tradingViewUrls' in data) || tradingViewUrlsOk(data.tradingViewUrls));
    }

    // Setup tags: a short list of short strings. Checked one index at a time
    // because rules have no loop. Empty list is valid (a trade with no setup).
    function setupItemOk(item) {
      return item is string && item.size() > 0 && item.size() <= 40;
    }
    function setupsFieldOk(setups) {
      return setups is list && setups.size() <= 8
        && (setups.size() < 1 || setupItemOk(setups[0]))
        && (setups.size() < 2 || setupItemOk(setups[1]))
        && (setups.size() < 3 || setupItemOk(setups[2]))
        && (setups.size() < 4 || setupItemOk(setups[3]))
        && (setups.size() < 5 || setupItemOk(setups[4]))
        && (setups.size() < 6 || setupItemOk(setups[5]))
        && (setups.size() < 7 || setupItemOk(setups[6]))
        && (setups.size() < 8 || setupItemOk(setups[7]));
    }

    // TradingView links on a trade: at most four https tradingview.com URLs.
    // Same pattern as normalizeTradingViewUrl() in src/utils/tradingViewLink.js.
    function tvLinkOk(item) {
      return item is string && item.size() > 0 && item.size() <= 2000
        && item.matches('^https://([A-Za-z0-9-]+\\.)*tradingview\\.com(/.*)?$');
    }
    function tradingViewUrlsOk(urls) {
      return urls is list && urls.size() <= 4
        && (urls.size() < 1 || tvLinkOk(urls[0]))
        && (urls.size() < 2 || tvLinkOk(urls[1]))
        && (urls.size() < 3 || tvLinkOk(urls[2]))
        && (urls.size() < 4 || tvLinkOk(urls[3]));
    }

    // Trade UPDATE validation. updateDoc() merges, so `data` here is the FULL
    // post-merge document — but re-running isValidTrade() on it outright would
    // brick legacy documents: trades written before create-validation existed
    // (and before the futures dual-shape) can carry string prices / missing
    // fees, and ANY update to them — even {journalId: x} from the journal
    // migration — would be denied because the merged doc still holds the old
    // field. Instead we validate only the fields this update actually CHANGES:
    // untouched legacy values are grandfathered, while nobody can move a
    // validated field to an invalid value (entryPrice: -1, direction: 'x').
    // Fields the app adds only after create (exits/result/netPnl/updatedAt/
    // tpReached/limitTriggered/…) are not constrained by create either, so
    // they pass untouched.
    function isValidTradeUpdate(data, prev) {
      let changed = data.diff(prev).affectedKeys();
      return (!changed.hasAny(['entryPrice']) || (data.entryPrice is number && data.entryPrice > 0))
        && (!changed.hasAny(['quantity']) || (data.quantity is number && data.quantity > 0))
        // stopLoss accepts a bounded string too: the deployed client's
        // auto-SL path (PendingLimitOrders.handleUpdateSL) writes
        // String(newSL), and old app versions stay in the wild — a
        // number-only rule would silently break their SL updates.
        && (!changed.hasAny(['stopLoss'])
          || (data.stopLoss is number && data.stopLoss >= 0)
          || (data.stopLoss is string && data.stopLoss.size() <= 30))
        && (!changed.hasAny(['fees']) || (data.fees is number && data.fees >= 0))
        && (!changed.hasAny(['direction']) || data.direction in ['long', 'short'])
        && (!changed.hasAny(['status']) || data.status in ['open', 'closed', 'partial'])
        && (!changed.hasAny(['pair']) || (data.pair is string && data.pair.size() > 0 && data.pair.size() <= 30))
        // Same crypto/futures branch as create, applied only when the update
        // touches the fields that pick or feed the branch.
        && (!changed.hasAny(['assetClass', 'leverage', 'contract'])
          || (data.get('assetClass', 'crypto') == 'futures_cme'
            ? (data.contract is map
              && data.contract.contracts is number && data.contract.contracts > 0
              && data.contract.pointValue is number && data.contract.pointValue > 0
              && data.contract.tickSize is number && data.contract.tickSize > 0)
            : (data.leverage is number && data.leverage >= 1 && data.leverage <= 200)))
        // Only when this update touches setups. Legacy trades that never had
        // the field keep updating every other field exactly as before.
        && (!changed.hasAny(['setups']) || !('setups' in data) || setupsFieldOk(data.setups))
        && (!changed.hasAny(['tradingViewUrls']) || !('tradingViewUrls' in data) || tradingViewUrlsOk(data.tradingViewUrls));
    }

    // Minimal shape backstop for the free-form subcollections (journals,
    // backtests, dca, strategies, notes, tradingPlans, morningJournals,
    // eveningJournals, processes, backtestJournals). Their documents
    // are written by many forms with varied shapes — the widest legitimate
    // shape today is ~20 fields (PlanForm) — so this deliberately caps only
    // the FIELD COUNT, not per-field content: the goal is blocking raw-SDK
    // megablob documents, not enforcing a strict schema.
    function isBoundedDoc(data) {
      return data.size() < 60;
    }

    // Leaderboard entry validation. Must match the exact shape the client
    // writes (useLeaderboardSync.js): displayName, photoURL, joinedAt,
    // updatedAt, live{}, backtest{}, score. The previous version validated
    // top-level winRate/totalTrades/profitFactor — fields the client never
    // writes — so EVERY legitimate write was permission-denied. Now we also
    // bound `score` (the sort key) to 0–100 so a user can't setDoc score:999999
    // and pin themselves to the top.
    // photoURL must be https (or null/empty) — it's rendered as an <img src>
    // to EVERY signed-in user, and the client only ever sends the Firebase
    // Auth provider photo (always https) or null, so a javascript:/data:
    // value can only come from a raw-SDK write. live/backtest are key-capped
    // (client writes 6 and 3 keys) so this world-readable doc can't become
    // free unbounded storage.
    function isValidLeaderboardEntry(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'joinedAt', 'updatedAt', 'live', 'backtest', 'score'])
        && data.displayName is string && data.displayName.size() <= 50
        && (!('photoURL' in data) || data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 1000
            && (data.photoURL == '' || data.photoURL.matches('https://.*'))))
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.live is map && data.live.size() < 40
        && data.backtest is map && data.backtest.size() < 40;
    }

    // Legacy trade screenshot. dataUrl is a client-compressed WebP/JPEG/PNG.
    // The 350,000 char cap keeps every doc far below Firestore's 1 MiB limit,
    // and the prefix check means only raster image data URLs are ever rendered
    // as <img src>. New charts are TradingView links on the trade, not files.
    function isValidTradeImage(data) {
      return data.keys().hasAll(['tradeId', 'dataUrl', 'kind', 'createdAt'])
        && data.keys().hasOnly(['tradeId', 'dataUrl', 'kind', 'caption', 'width', 'height', 'createdAt', 'updatedAt'])
        && data.tradeId is string && data.tradeId.size() > 0 && data.tradeId.size() <= 128
        && data.dataUrl is string && data.dataUrl.size() <= 350000
        && data.dataUrl.matches('data:image/(webp|jpeg|png);base64,.+')
        && data.kind in ['before', 'after', 'other']
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 200))
        && (!('width' in data) || (data.width is int && data.width > 0 && data.width <= 10000))
        && (!('height' in data) || (data.height is int && data.height > 0 && data.height <= 10000))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
  }
}
