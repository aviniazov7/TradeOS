{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trade-os",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
    // 1 = every request. CSP reports are rare; sampling them away looks like
    // a week with no violations. Workers Logs keeps console lines for 7 days.
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    { "binding": "ALERTS_KV", "id": "5c66041d98aa4229a52afeb2f5b1f652" }
  ],
  // Per-user AI quota. SQLite-backed (new_sqlite_classes) so it runs on the
  // Workers Free plan — KV-backed Durable Objects are paid-only. One object
  // per uid via getByName. The migration tag runs on the next `wrangler deploy`
  // of this worker; do not edit the tag once it has been applied.
  "durable_objects": {
    "bindings": [
      { "name": "AI_QUOTA", "class_name": "AiQuotaDO" }
    ]
  },
  "migrations": [
    { "tag": "v1-ai-quota", "new_sqlite_classes": ["AiQuotaDO"] }
  ],
  "vars": {
    "DEV_UID": "3eVK7Ej3F1Y2L2ziHJpmzFP7Q0u1",
    // Gemini routing for Premium chat. Kept OFF because the free Gemini tier
    // returns 429 "quota exceeded — check billing" (verified via /admin/ai-test
    // 2026-07-27) — activating it just wastes a doomed call before falling back
    // to Groq. Everyone (free + premium) runs on Groq, which is free and works.
    // Flip to "true" ONLY once billing is enabled on the Gemini project.
    // Defined here (not in the dashboard) so wrangler deploys don't wipe it.
    "GEMINI_ENABLED": "false"
  },
  // Staging is a separate Worker script (legacy env naming: trade-os-staging).
  // Deploy it only with `wrangler deploy --config wrangler.jsonc --env staging`
  // from repo root. A bare `wrangler deploy` (and the Vite plugin redirect at
  // .wrangler/deploy/config.json) still targets the top-level name `trade-os`.
  // Bindings are not inherited, so they are repeated here. There is no cron:
  // tradeos-alerts stays the only scheduled Worker and deploys from main.
  // ALERTS_KV is the staging namespace, not production. Exchange connections
  // in production KV are not visible here and must be reconnected on the dev
  // channel (staging also has its own CREDS_ENCRYPTION_KEY). See docs/WORKFLOW.md.
  "env": {
    "staging": {
      "name": "trade-os-staging",
      // Not inherited from the top-level block. This Worker is what `dev` deploys.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "single-page-application"
      },
      "kv_namespaces": [
        { "binding": "ALERTS_KV", "id": "ac57c9487d5044eda008e06100a05758" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "AI_QUOTA", "class_name": "AiQuotaDO" }
        ]
      },
      "migrations": [
        { "tag": "v1-ai-quota", "new_sqlite_classes": ["AiQuotaDO"] }
      ],
      "vars": {
        "DEV_UID": "3eVK7Ej3F1Y2L2ziHJpmzFP7Q0u1",
        "GEMINI_ENABLED": "false"
      }
    }
  }
}
